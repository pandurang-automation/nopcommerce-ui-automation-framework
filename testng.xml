<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Automation Suite"
       parallel="methods"
       thread-count="2">

    <listeners>
        <listener class-name="com.ultron.tests.listeners.TestListener"/>
    </listeners>

    <test name="Frontend Tests">
        <classes>
            <class name="com.ultron.tests.saucedemo.LoginTest"/>
            <class name="com.ultron.tests.saucedemo.LogoutTest"/>
        </classes>

    </test>

</suite>
